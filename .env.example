# Names only. Copy to .env and fill in the values. NEVER commit .env or paste real values here.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

DATABASE_URL=                  # Neon Postgres connection string (use the pooled one)
GEMINI_API_KEY=
GEMINI_MODEL=                  # e.g. gemini-3.8-flash
HUNTER_API_KEY=
HUNTER_MAX_CALLS_PER_RUN=      # hard cap on fresh Hunter lookups per run (the Growth Lead set 5)
SENDER_NAME=                   # signs the email draft
DEMO_EMAIL=                    # the ONLY address a draft is addressed to
GROWTH_LEAD_GMAIL=             # the Growth Lead's mailbox that holds the drafts
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=     # made by scripts/gmail_authorize.py (scope: gmail.compose only)

# Only for local setup scripts (not needed on Vercel):
NEON_API_KEY=
